{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hyleon Trial T",
  "version": "0.0.1",
  "identifier": "com.example.hyleon-trial-t",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Trial T (Leptos + Tauri)",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "set by CI for each run",
      "endpoints": ["http://127.0.0.1:8765/latest.json"],
      "dangerousInsecureTransportProtocol": true,
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
